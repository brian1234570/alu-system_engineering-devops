#!/usr/bin/env bash
# Installs HAProxy and load balances web-01 and web-02 with the roundrobin algorithm
sudo apt-get update -y
sudo apt-get install -y haproxy

# Let the init script start HAProxy (needed on older Ubuntu versions)
if [ -f /etc/default/haproxy ]; then
    sudo sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/haproxy
fi

# Keep a backup of the existing configuration (only the first time)
sudo cp -n /etc/haproxy/haproxy.cfg /etc/haproxy/haproxy.cfg.bak

# Write a complete configuration so the result is the same on any machine
sudo tee /etc/haproxy/haproxy.cfg > /dev/null << 'EOF'
global
    log /dev/log local0
    maxconn 2048
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend web-frontend
    bind *:80
    default_backend web-backend

backend web-backend
    balance roundrobin
    server 7377-web-01 35.177.173.247:80 check
    server 7377-web-02 18.132.97.141:80 check
EOF

sudo service haproxy restart
