#!/usr/bin/env bash
# Run Nginx as the nginx user, listening on port 8080
chmod 644 /etc/nginx/nginx.conf
sed -i 's/^#*user .*;/user nginx;/' /etc/nginx/nginx.conf
sed -i 's/listen 80 /listen 8080 /; s/listen \[::\]:80 /listen [::]:8080 /; s/listen 80;/listen 8080;/; s/listen \[::\]:80;/listen [::]:8080;/' /etc/nginx/sites-enabled/default
pkill apache2
sudo -u nginx service nginx restart
